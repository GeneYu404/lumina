{
  "name": "lumina-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-portable.ps1",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "node tools/make-icons.mjs",
    "fetch:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-ffmpeg.ps1",
    "fetch:ffmpeg:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-ffmpeg.ps1 -Stage",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-sidecar.ps1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "lucide-react": "^1.48.0",
    "mygo-runtime": "^0.3.7",
    "preact": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "mygo-cli": "^0.3.7",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}