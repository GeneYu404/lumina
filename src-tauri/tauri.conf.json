{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina",
  "version": "1.0.0",
  "identifier": "app.lumina.viewer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "拾光",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "Lumina",
    "shortDescription": "拾光 · 图片与视频查看器",
    "longDescription": "Windows 11 风格的图片与视频查看器：缩放、平移、旋转、裁剪、调色、视频播放、幻灯片放映与 EXIF 信息。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jfif", "png", "gif", "webp", "avif", "bmp", "ico", "svg", "tif", "tiff"],
        "name": "Lumina.Image",
        "description": "图片",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "m4v", "mov", "webm", "mkv"],
        "name": "Lumina.Video",
        "description": "视频",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}